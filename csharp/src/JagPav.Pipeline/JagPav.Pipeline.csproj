<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Generate XML documentation file for the assembly-->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>JagPav.Pipeline</PackageId>
        <Version>2.0.0</Version>
        <Authors>Mario Pavlović</Authors>
        <Company>JagPav</Company>
        <Description>A compensable pipeline for .NET, built on TPL Dataflow: thread a model through ordered steps, auto-compensating completed steps in reverse order on failure. Every step shares the same model-and-cancellation-token contract, so the resulting code is much more readable and the business flow is easier to follow at a glance.</Description>
        <PackageTags>pipeline;compensable-pipeline;saga;orchestration;dataflow;tpl-dataflow;rollback;compensation;dotnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/pavlek1817/jag-pipeline</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>2.0.0 (breaking): pipelines are now created with PipelineBuilder&lt;TModel&gt;().Build() instead of Pipeline&lt;TModel&gt;().CreatePipeline(); steps and compensations return Task&lt;TModel&gt;; a failed run throws PipelineException with the step's exception as OriginalException. Added: OnFailure action, CompensationStrategy (ContinueOnFailure, StopOnFirstFailure), and failure details on PipelineException. Fixed: a compensation that threw made ExecuteAsync hang. Full notes and upgrade guide: https://github.com/pavlek1817/jag-pipeline/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
